{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/e2e/**,docs/**,backend/tests/**,backend/benchmarks/**,.github/**}"
    }
  }
}
