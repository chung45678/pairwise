# Copy to .env and fill in what you need. Everything is optional.

# Database. SQLite by default. Any postgres:// or postgresql:// URL works (Neon, Supabase, RDS).
DATABASE_URL=sqlite:///./pairwise.db

# LLM-written icebreakers (falls back to templates on any error)
ANTHROPIC_API_KEY=
PAIRWISE_ICEBREAKER_MODEL=claude-haiku-5-5

# Embeddings for scoring instead of TF-IDF (any OpenAI-compatible /embeddings endpoint)
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# Public read-only demo at /e/demo (on by default on Vercel, off locally)
PAIRWISE_DEMO=
PAIRWISE_DEMO_KEY=try-the-demo

# Frontend: show a "Source on GitHub" link on the landing page
VITE_REPO_URL=
